<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>1단계: 달리기 프로토타입</title>
    <style>
        body {
            margin: 0;
            background-color: #111;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        canvas {
            background-color: #1a1a1a;
            border: 2px solid #444;
        }
    </style>
</head>
<body>

    <canvas id="gameCanvas" width="800" height="400"></canvas>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        // 1. 캐릭터 상태 설정 (위치, 크기, 달리기 속도)
        let player = {
            x: 100,
            y: 200,
            radius: 15,
            speed: 3 // 숫자가 높을수록 빨라집니다
        };

        // 카메라도 캐릭터를 따라 오른쪽으로 이동하게 만드는 변수
        let cameraX = 0;

        // 2. 매 프레임마다 화면을 새로 그리는 메인 루프 함수
        function animate() {
            // 캐릭터 위치를 오른쪽으로 계속 증가 (자동 달리기)
            player.x += player.speed;

            // 카메라는 캐릭터보다 조금 뒤에서 따라가도록 설정
            cameraX = player.x - 150;

            // 이전 프레임 잔상 지우기
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // 카메라 이동 적용 시작
            ctx.save();
            ctx.translate(-cameraX, 0);

            // [그리기 1] 신경 세포막 (가로로 긴 회색 막대)
            ctx.fillStyle = '#444';
            ctx.fillRect(0, 210, player.x + 1000, 20);

            // [그리기 2] 캐릭터 (빨간 동그라미)
            ctx.fillStyle = '#ff3333';
            ctx.beginPath();
            ctx.arc(player.x, player.y, player.radius, 0, Math.PI * 2);
            ctx.fill();

            // 카메라 이동 적용 끝
            ctx.restore();

            // 다음 프레임에 다시 animate 함수 실행 (무한 반복)
            requestAnimationFrame(animate);
        }

        // 게임 시작
        animate();
    </script>
</body>
</html>